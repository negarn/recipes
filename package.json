{
  "name": "recipes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "bun": ">=1.3" },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build && bun run build:worker",
    "build:worker": "bun build worker/index.ts --target=browser --format=esm --outfile=dist/_worker.js",
    "preview": "wrangler pages dev dist --port 8788",
    "deploy": "bun run build && wrangler d1 migrations apply DB --remote && wrangler pages deploy dist --branch main",
    "password": "bun scripts/password.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:import": "bun scripts/import.ts",
    "test": "bun run build:worker && vitest",
    "test:run": "bun run build:worker && vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "miniflare": "^4.20260730.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.5",
    "vite": "^6.4.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "esbuild": "^0.27.7",
    "postcss": "^8.5.13",
    "uuid": "^14.0.0"
  }
}
